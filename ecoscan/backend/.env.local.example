# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local

# -------------------------------------------------------------------
# Required — your Google Cloud project settings
# -------------------------------------------------------------------

# The Google Cloud Project ID that has Vertex AI / Gemini API enabled
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# The Google Cloud region to use for Vertex AI API calls (e.g. us-central1)
GOOGLE_CLOUD_LOCATION=us-central1

# -------------------------------------------------------------------
# Optional — backend server tuning (these have safe defaults)
# -------------------------------------------------------------------

# Port the backend API server listens on locally (default: 5000)
API_BACKEND_PORT=5000

# Maximum accepted request payload size (default: 7mb)
API_PAYLOAD_MAX_SIZE=7mb
